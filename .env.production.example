# Copy this file:  cp .env.production.example .env.production
# Then edit .env.production and run: npm run build
# (Never commit .env.production; it is gitignored.)

# Railway API — required for Hostinger. No trailing slash.
# Copy exact domain from Railway → Service → Settings → Networking → Public domain
REACT_APP_API_URL=https://nova-ecommerce-project-backend-production.up.railway.app

# Your Hostinger site — https, no trailing slash (SEO / meta).
REACT_APP_SITE_URL=https://www.bazaar-pk.com

# Optional — paste meta tag content from Google Search Console (HTML tag method)
# REACT_APP_GSC_VERIFICATION=your_verification_code_here

# GA4 Measurement ID (also in public/index.html gtag snippet)
# REACT_APP_GA4_MEASUREMENT_ID=G-S6GWN1X1JT
# REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_live_...
