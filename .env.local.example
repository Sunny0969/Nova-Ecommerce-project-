# Local dev overrides (Create React App loads .env.local over .env)
# Copy to .env.local and restart: npm start

# Use local backend (backend must be running on port 5001)
# REACT_APP_API_URL=http://127.0.0.1:5001

# Or keep production API (default in .env) — products always available:
# REACT_APP_API_URL=https://nova-ecommerce-project-backend-production.up.railway.app

# Stripe live/test publishable key (must match backend STRIPE_SECRET_KEY mode)
# REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_live_...
