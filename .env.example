# Copy to .env.local for local development (Create React App loads .env / .env.local)
# Get test keys from https://dashboard.stripe.com/apikeys

# Backend API origin (no trailing slash; /api is normalized away).
# Production (Hostinger): set in .env.production — see .env.production.example
# REACT_APP_API_URL=https://your-backend.up.railway.app
# Production: copy secrets to .env.production then run npm run build (Hostinger deploys the build/ folder).

REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Optional local override — copy to .env.local (overrides .env):
# REACT_APP_API_URL=http://127.0.0.1:5001
# Requires backend/.env MONGODB_URI with product data (same as Railway for full catalog).

# Canonical public site URL (no trailing slash) — used for SEO, Open Graph, and JSON-LD. Example: https://www.novashop.com
# REACT_APP_SITE_URL=https://www.example.com
