# Hostinger / Apache — Bazaar (bazaar-pk.com)
# Canonical origin: https://www.bazaar-pk.com (301, path + query preserved)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- 1) HTTP → HTTPS (apex + www) ---
  RewriteCond %{HTTP_HOST} ^(www\.)?bazaar-pk\.com$ [NC]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- 2) HTTPS non-www → HTTPS www ---
  RewriteCond %{HTTP_HOST} ^bazaar-pk\.com$ [NC]
  RewriteRule ^ https://www.bazaar-pk.com%{REQUEST_URI} [R=301,L]

  # --- 3) Legacy URL 301s (match old inbound links / sitemap URLs) ---
  RewriteRule ^products/?$ /shop [R=301,L,NC]
  RewriteRule ^products/.+ /shop [R=301,L,NC]
  RewriteRule ^product/([^/]+)/?$ /shop/$1 [R=301,L,NC]
  RewriteRule ^shop/category/([^/]+)/([^/]+)/?$ /$1/$2 [R=301,L,NC]
  RewriteRule ^shop/category/([^/]+)/?$ /$1 [R=301,L,NC]
  RewriteRule ^category/([^/]+)/?$ /$1 [R=301,L,NC]
  RewriteRule ^home/?$ / [R=301,L,NC]

  RewriteCond %{QUERY_STRING} (^|&)category=([^&]+) [NC]
  RewriteCond %{QUERY_STRING} !(^|&)brand= [NC]
  RewriteRule ^shop/?$ /%2? [R=301,L,NE]

  RewriteCond %{QUERY_STRING} (^|&)brand=([^&]+) [NC]
  RewriteCond %{QUERY_STRING} !(^|&)category= [NC]
  RewriteRule ^shop/?$ /brand/%2? [R=301,L,NE]

  # --- React SPA: non-file routes → index.html (flag for no-cache header below) ---
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L,E=SPA:1]
</IfModule>

<IfModule mod_headers.c>
  # HTML shell + SPA fallback — always revalidate after deploy
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
  Header always set Cache-Control "no-cache, must-revalidate" env=SPA

  # Push / service workers — do not cache long-term
  <FilesMatch "^(OneSignalSDKWorker\.js|OneSignalSDK\.page\.js|service-worker\.js|sw\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Static assets — exactly 6 months (15552000 seconds), immutable
  <FilesMatch "\.(js|mjs|cjs|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|otf|webp|map|webmanifest)$">
    Header set Cache-Control "public, max-age=15552000, immutable"
  </FilesMatch>
</IfModule>
